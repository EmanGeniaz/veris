# ── GenVeris environment ─────────────────────────────────────────────
# Copy to .env and fill in. Each variable independently turns on a capability;
# the app runs fully in demo mode (localStorage + simulated AI) with none set.

# Live AI — real inference through the gateway (advisor, guardrails, cost).
# Without it, AI paths fall back to a grounded simulation.
ANTHROPIC_API_KEY=""
# Optional — gateway model id (defaults to claude-sonnet-5).
VZ_GATEWAY_MODEL="claude-sonnet-5"

# Durable data — Postgres instead of localStorage. Must be a REAL connection
# string starting with postgres (a localhost user:password placeholder is
# treated as "not configured").
# Supabase: Transaction pooler (port 6543) for the running app.
DATABASE_URL="postgresql://postgres.[ref]:[PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Supabase: Session pooler / direct (port 5432) for migrations (db push).
# For a single-database setup, set this equal to DATABASE_URL.
DIRECT_URL="postgresql://postgres.[ref]:[PASSWORD]@aws-0-[region].pooler.supabase.com:5432/postgres"

# Auth + server-side RBAC (403s on unauthorized writes). Needs a database too.
# Generate with: openssl rand -base64 32   (or: npx auth secret)
AUTH_SECRET=""

# Optional SSO — set the pair to switch a provider on.
# AUTH_MICROSOFT_ENTRA_ID_ID=""
# AUTH_MICROSOFT_ENTRA_ID_SECRET=""
# AUTH_MICROSOFT_ENTRA_ID_ISSUER=""
# AUTH_GOOGLE_ID=""
# AUTH_GOOGLE_SECRET=""

# Demo Center password gate (server-side only, never NEXT_PUBLIC). There is no
# built-in default: with this unset, the demo sign-in refuses every attempt.
DEMO_PASSWORD=""

# ── Operator / platform admin ────────────────────────────────────────
# Shared token for operator-only endpoints: tenant provisioning
# (/api/admin/tenants), plane entitlement grants (/api/admin/entitlements) and
# Enforce connection config (/api/admin/enforce-connection). Unset → those
# endpoints refuse every request (403). Generate with: openssl rand -base64 32
VZ_ONBOARD_TOKEN=""

# ── Secret store (WS2 — connector credentials) ───────────────────────
# Master key for sealing per-tenant connector credentials (e.g. a Veris Enforce
# gateway token) at rest with AES-256-GCM. Must be 32 bytes, base64. Unset → the
# secret store is OFF: a credential is never stored in the clear and Enforce
# connections that need one stay unconfigured. Generate with: openssl rand -base64 32
VZ_SECRETS_KEY=""

# ── Rate limiting (security baseline · control 1) ────────────────────
# All optional; defaults shown. Limits are per client IP per window.
# RATE_LIMIT_AUTH_MAX=20            # sign-in, register, demo-login, admin tokens
# RATE_LIMIT_AUTH_WINDOW_SEC=900
# RATE_LIMIT_PUBLIC_MAX=60          # unauthenticated APIs (policy/inspect, ingest)
# RATE_LIMIT_PUBLIC_WINDOW_SEC=60
# RATE_LIMIT_USER_MAX=120           # authenticated writes (bus, knowledge, gateway)
# RATE_LIMIT_USER_WINDOW_SEC=60
# RATE_LIMIT_GLOBAL_MAX=600         # backstop on every /api/* request (middleware)
# RATE_LIMIT_GLOBAL_WINDOW_SEC=60
# Per-account sign-in backoff: after N failures, wait BASE·2^(n−N) ms (capped).
# AUTH_BACKOFF_FREE_ATTEMPTS=5
# AUTH_BACKOFF_BASE_MS=1000
# AUTH_BACKOFF_MAX_MS=900000
# AUTH_BACKOFF_MEMORY_SEC=3600
# Local load tests / E2E only — never in production.
# RATE_LIMIT_DISABLED=1
