# Copy this file to ".env" and fill in.  NEVER commit the real .env.

# Which environment to test. Defaults to the public demo if unset.
# For authenticated/write tests, point this at your STAGING url — NEVER production.
BASE_URL=https://console.veriszone.com

# Throwaway test account on STAGING only. Do NOT use a real admin or customer login.
TEST_EMAIL=
TEST_PASSWORD=
